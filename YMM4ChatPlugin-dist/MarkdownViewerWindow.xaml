<Window x:Class="YMM4ChatPlugin.MarkdownViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="680" Height="540"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 本文エリア（FlowDocumentScrollViewer でマークダウンを表示） -->
        <FlowDocumentScrollViewer x:Name="DocumentViewer"
                                  Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                  HorizontalScrollBarVisibility="Disabled"/>

        <!-- 下部ボタンエリア -->
        <Border Grid.Row="1"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,1,0,0"
                Padding="10">
            <Button x:Name="CloseButton" Content="閉じる" Width="100"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    Click="CloseButton_Click"/>
        </Border>
    </Grid>
</Window>
