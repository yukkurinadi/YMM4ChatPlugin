<UserControl x:Class="YMM4ChatPlugin.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YMM4ChatPlugin"
             Focusable="True"
             Height="600" Width="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!--
            Foreground は一切設定しない。
            YMM4 のホストウィンドウが Foreground を設定し、
            子要素はプロパティ継承で自動的に正しいテーマ文字色を得る。

            「薄く」見せたい要素は Foreground でなく Opacity を使う
            → ダーク/ライト/カスタムテーマどれでも比率で薄くなる。
        -->
        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <Style x:Key="SystemMessageStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <Style x:Key="JoinLeaveMessageStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
    </UserControl.Resources>

    <!--
        Background も未設定。YMM4 のパネル背景がそのまま見える。
        パネルの視覚的区別は半透明色（EffectBrowserToolPlugin と同じ方式）。
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 同意エリア -->
        <Border x:Name="AgreementBorder" Grid.Row="0" Grid.ColumnSpan="2"
                Background="#1A808080"
                BorderBrush="#33808080"
                BorderThickness="1" Margin="10,10,10,5" Padding="5"
                Visibility="{Binding IsAgreed, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="このプラグインを利用する前に、以下の利用規約とプライバシーポリシーをお読みください。"
                           TextWrapping="Wrap" Margin="0,0,0,5"/>
                <WrapPanel>
                    <Button x:Name="TermsButton" Content="📄 利用規約を読む"
                            Width="150" Margin="0,0,10,0" Cursor="Hand"/>
                    <Button x:Name="PrivacyButton" Content="🔒 プライバシーポリシーを読む"
                            Width="180" Margin="0,0,10,0" Cursor="Hand"/>
                    <CheckBox x:Name="AgreeCheckBox"
                              Content="両方のリンクを読み、利用規約とプライバシーポリシーに同意します"
                              IsEnabled="False" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 左パネル：ルーム一覧 -->
        <Border Grid.Row="1" Grid.RowSpan="4" Grid.Column="0"
                Background="#1A808080"
                BorderBrush="#33808080"
                BorderThickness="1" Margin="10,5,5,10" Padding="5">
            <StackPanel>
                <TextBlock Text="ルーム一覧" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding FilteredRooms.Count, StringFormat=ルーム数: {0}}"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding RoomSearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,5" ToolTip="ルーム名を検索"/>
                <ListBox ItemsSource="{Binding FilteredRooms}"
                         SelectedItem="{Binding SelectedRoom}"
                         Height="200"
                         IsEnabled="{Binding IsListBoxEnabled}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Width="120"/>
                                <TextBlock Text="{Binding Id}"
                                           Style="{StaticResource MutedTextStyle}"
                                           FontSize="10" Margin="5,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Command="{Binding ShowCreateRoomDialogCommand}"
                        Content="➕ 新しいルーム" Margin="0,10,0,5"
                        IsEnabled="{Binding IsAgreed}"/>
            </StackPanel>
        </Border>

        <!-- 右パネル：ユーザー名 -->
        <WrapPanel Grid.Row="1" Grid.Column="1" Margin="5,5,10,5" VerticalAlignment="Center">
            <TextBlock Text="ユーザー名:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                     Width="120" Margin="0,0,15,0"
                     IsEnabled="{Binding IsAgreed}"/>
        </WrapPanel>

        <!-- 接続情報 -->
        <Border Grid.Row="2" Grid.Column="1"
                Background="#1A808080"
                BorderBrush="#33808080"
                BorderThickness="1" Margin="5,5,10,10" Padding="5">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="現在のルーム名: " VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Text="{Binding CurrentRoomName}" Width="180" IsReadOnly="True"/>
                <Button Command="{Binding CopyRoomIdCommand}" Content="📋 IDコピー"
                        Width="80" Margin="10,0,0,0"
                        IsEnabled="{Binding IsAgreed}"
                        ToolTip="ルームIDをクリップボードにコピーします"/>
            </WrapPanel>
        </Border>

        <!-- メッセージ表示エリア -->
        <ListBox Grid.Row="3" Grid.Column="1"
                 ItemsSource="{Binding Messages}"
                 Margin="5,0,10,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="System">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"
                                                               Style="{StaticResource SystemMessageStyle}"/>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="JoinLeave">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"
                                                               Style="{StaticResource JoinLeaveMessageStyle}"/>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- メッセージ送信エリア -->
        <Grid Grid.Row="4" Grid.Column="1" Margin="5,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Margin="0,0,5,0"
                     MinWidth="100"
                     IsEnabled="{Binding IsAgreed}"/>
            <Button Grid.Column="1" Content="送信"
                    Command="{Binding SendMessageCommand}"
                    Width="70" Height="30" IsDefault="True"
                    IsEnabled="{Binding IsAgreed}"/>
        </Grid>
    </Grid>
</UserControl>